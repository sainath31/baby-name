[{"name":"Ashwatthama","devanagari":"अश्वत्थामा","iast":"aśvatthāman","meaning_en":"Having the strength of a horse; Drona's son.","parts":"aśva + sthāman","source":"hand-compiled"},{"name":"Babruvahana","devanagari":"बभ्रुवाहन","iast":"babhruvāhana","meaning_en":"Arjuna's son from Manipur.","parts":"babhru + vāhana","source":"hand-compiled"},{"name":"Dhrishtadyumna","devanagari":"धृष्टद्युम्न","iast":"dhṛṣṭadyumna","meaning_en":"Bold and splendid; Draupadi's brother.","parts":"dhṛṣṭa + dyumna","source":"hand-compiled"},{"name":"Jambavan","devanagari":"जाम्बवान","iast":"jāmbavān","meaning_en":"King of bears.","parts":"jāmbavat","source":"hand-compiled"},{"name":"Janamejaya","devanagari":"जनमेजय","iast":"janamejaya","meaning_en":"Who makes people tremble; Parikshit's son.","parts":"jana + ejaya","source":"hand-compiled"},{"name":"Mandhata","devanagari":"मान्धाता","iast":"māndhātṛ","meaning_en":"Great emperor of the Ikshvaku line.","parts":"māndhātṛ","source":"hand-compiled"},{"name":"Pururavas","devanagari":"पुरूरवस","iast":"purūravas","meaning_en":"Ancestor of the lunar dynasty.","parts":"puru + ravas","source":"hand-compiled"}]