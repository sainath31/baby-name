[{"name":"Appalaraju","devanagari":"अप्पलराजु","iast":"appalarāju","meaning_en":"King Appala; devotee of Lord Venkateswara, from the Telugu honorific for the deity.","parts":"appala + rāju","source":"hand-compiled"},{"name":"Chalapathi","devanagari":"चलपति","iast":"calapati","meaning_en":"Lord of the moving; a name from the Telugu tradition (Chalapathi Rao).","parts":"cala + pati","source":"hand-compiled"},{"name":"Channakeshava","devanagari":"चन्नकेशव","iast":"cennakeśava","meaning_en":"Beautiful Keshava; Vishnu of Belur.","parts":"cenna + keśava","source":"hand-compiled"},{"name":"Dharmaraj","devanagari":"धर्मराज","iast":"dharmarāj","meaning_en":"King of righteousness; Yudhishthira, and Yama.","parts":"dharma + rāja","source":"hand-compiled"},{"name":"Gurunath","devanagari":"गुरुनाथ","iast":"gurunāth","meaning_en":"Teacher-lord; Lord of gurus.","parts":"guru + nātha","source":"hand-compiled"},{"name":"Halesh","devanagari":"हलेश","iast":"haleś","meaning_en":"Lord with the plough; Balarama.","parts":"hala + īśa","source":"hand-compiled"},{"name":"Jagan","devanagari":"जगन","iast":"jagan","meaning_en":"The world; short form of Jagannath or Jaganmohan.","parts":"jagat","source":"hand-compiled"},{"name":"Kameswara","devanagari":"कामेश्वर","iast":"kāmeśvara","meaning_en":"Lord of desires; Shiva (Telugu form).","parts":"kāma + īśvara","source":"hand-compiled"},{"name":"Kiccha","devanagari":"किच्चा","iast":"kicca","meaning_en":"Fire, sparkle; a popular Kannada nickname.","parts":"kicca","source":"hand-compiled"},{"name":"Kishan","devanagari":"किषन","iast":"kiṣṇ","meaning_en":"Krishna (northern form; also used in Karnataka).","parts":"kṛṣṇa","source":"hand-compiled"},{"name":"Krishnamohan","devanagari":"कृष्णमोहन","iast":"kṛṣṇamohan","meaning_en":"Enchanting Krishna.","parts":"kṛṣṇa + mohana","source":"hand-compiled"},{"name":"Krishnappa","devanagari":"कृष्णप्पा","iast":"kṛṣṇappa","meaning_en":"Krishna with the Kannada honorific -appa.","parts":"kṛṣṇa + appa","source":"hand-compiled"},{"name":"Lakshmipathi","devanagari":"लक्ष्मीपति","iast":"lakṣmīpati","meaning_en":"Husband of Lakshmi; Vishnu.","parts":"lakṣmī + pati","source":"hand-compiled"},{"name":"Nagabhushan","devanagari":"नागभूषण","iast":"nāgabhūṣaṇ","meaning_en":"Adorned with serpents; Shiva.","parts":"nāga + bhūṣaṇa","source":"hand-compiled"},{"name":"Rajasekhar","devanagari":"राजशेखर","iast":"rājaśekhar","meaning_en":"Crest of kings; Shiva as king; the Sanskrit poet Rajashekhara.","parts":"rāja + śekhara","source":"hand-compiled"},{"name":"Ramu","devanagari":"रामु","iast":"rāmu","meaning_en":"Affectionate short form of Rama.","parts":"rāma","source":"hand-compiled"},{"name":"Sesha","devanagari":"शेष","iast":"śeṣa","meaning_en":"The remainder; the serpent Shesha on whom Vishnu rests.","parts":"śeṣa","source":"hand-compiled"},{"name":"Sharath","devanagari":"शरत्","iast":"śarat","meaning_en":"Autumn (southern spelling).","parts":"śarad","source":"hand-compiled"},{"name":"Siddaraju","devanagari":"सिद्धराजु","iast":"siddarāju","meaning_en":"Perfected king; the saint Siddharameshwara.","parts":"siddha + rāju","source":"hand-compiled"},{"name":"Sivaprasad","devanagari":"शिवप्रसाद","iast":"śivaprasād","meaning_en":"Grace of Shiva.","parts":"śiva + prasāda","source":"hand-compiled"},{"name":"Somashekar","devanagari":"सोमशेखर","iast":"somaśekhar","meaning_en":"Crowned with the moon; Shiva.","parts":"soma + śekhara","source":"hand-compiled"},{"name":"Srikanth","devanagari":"श्रीकान्त","iast":"śrīkaṇṭh","meaning_en":"Lord Shiva with a blue throat; also a Telugu form of Shrikant.","parts":"śrī + kaṇṭha","source":"hand-compiled"},{"name":"Srikar","devanagari":"श्रीकर","iast":"śrīkar","meaning_en":"Bringing prosperity; Vishnu.","parts":"śrī + kara","source":"hand-compiled"},{"name":"Subba","devanagari":"सुब्ब","iast":"subba","meaning_en":"Short Telugu form of Subrahmanya (as in Subba Rao).","parts":"subrahmaṇya","source":"hand-compiled"},{"name":"Tirupati","devanagari":"तिरुपति","iast":"ti